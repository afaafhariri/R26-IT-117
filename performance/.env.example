# -----------------------------------------------------------------------------
# R26-IT-117 — Component 04 (Performance Monitoring & Delay Prediction)
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Only DATABASE_URL is required. Everything else has a working default or
# degrades gracefully when unset.
# -----------------------------------------------------------------------------

# ---- Database (REQUIRED) ----------------------------------------------------
# Postgres only — the schema uses SERIAL PRIMARY KEY, so SQLite will not work.
# Tables are created automatically on first run.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ---- Server -----------------------------------------------------------------
PORT=5004
FLASK_ENV=development

# ---- Timeline source (Component 03) -----------------------------------------
# local  → read projects/phases from this service's own Postgres tables, seeded
#          via POST /schedule. The default, and what to use today.
# remote → call the real Component 03 API. Not implemented yet; raises
#          NotImplementedError on use.
TIMELINE_SOURCE=local
TIMELINE_SERVICE_BASE_URL=

# ---- Google Gemini (LLM delay explanations) ---------------------------------
# Optional. When unset, the LLM-written explanation endpoints are the only
# thing affected — schedule, SPI and delay prediction all work without it.
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Weather (OpenWeatherMap) -----------------------------------------------
# Optional. Without a key, weather lookups fail gracefully and prediction
# falls back to non-weather features.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_API_COUNTRY_CODE=LK
WEATHER_API_TIMEOUT_SECONDS=5

# ---- Outbound delay alerts to C02 / C03 -------------------------------------
# Base host only (no path) — "/delay-alert" is appended automatically.
# Optional: alerts are only sent when a phase is classified HIGH risk.
C02_URL=http://localhost:8002
C03_URL=http://localhost:8000
NOTIFY_TIMEOUT_SECONDS=5

# ---- Training only (train.py) -----------------------------------------------
# Overrides the delay-cases CSV location. Unset = use the bundled data file.
DELAY_CASES_CSV_PATH=
