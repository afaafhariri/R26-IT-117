# Dependencies come from uv.lock inside the image, so the local .venv must
# never be copied in (it would replace the image's).
# tests/ and data/ stay in: the README runs the suite in the container, and
# the RAG index is built from data/.
.venv/
.env
.env.*

# Not needed at runtime: notebooks, offline training, docs
notebooks/
train.py
README.md

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
