# Copy to gateway/.env and fill in. Only DATABASE_URL is required; everything
# else has a local-development default.

# ── Database ──────────────────────────────────────────────────────────────────
# authdb, as the gateway's own login. Create both with db/create_authdb.sql.
DATABASE_URL=postgresql+psycopg://gateway:<password>@localhost:5432/authdb

# ── Sessions and CSRF ─────────────────────────────────────────────────────────
# Where the planner UI is served; links in emails point here.
APP_BASE_URL=http://localhost:5173
# Origins allowed to send POST/PUT/PATCH/DELETE (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Must be true in production (HTTPS). Set false for plain-HTTP local
# development if your browser is Safari, which refuses Secure cookies there.
COOKIE_SECURE=true

# ── Email ─────────────────────────────────────────────────────────────────────
# resend (production), smtp (Mailpit locally) or console (written to the log).
EMAIL_BACKEND=smtp
EMAIL_FROM=Construction Planner <no-reply@localhost>
# Only for EMAIL_BACKEND=resend. The From address must be on a domain you
# have verified in Resend.
RESEND_API_KEY=
# Only for EMAIL_BACKEND=smtp. Mailpit from docker-compose listens here.
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Component services ────────────────────────────────────────────────────────
C01_URL=http://localhost:8001
C02_URL=http://localhost:8002
C03_URL=http://localhost:8000
C04_URL=http://localhost:5004

# Read timeout (seconds) for a proxied request. C01 can take minutes.
UPSTREAM_TIMEOUT_SECONDS=300
