# -----------------------------------------------------------------------------
# R26-IT-117 — Component 01 (Architectural Planning API)
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Loaded automatically by:
#   - architecture/main.py        (FastAPI app)
#   - architecture/tasks/celery_app.py  (Celery worker)
# Both call `load_dotenv(<repo-root>/.env)` at startup.
# -----------------------------------------------------------------------------

# ---- Logging ----------------------------------------------------------------
# JSON-structured logger level. One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- JSON schema directory --------------------------------------------------
# Where SchemaAssembler / SchemaSerialiser load site_schema.json and
# building_schema.json from. Relative paths resolve against the API process CWD
# (run from architecture/), so `../shared/schemas` is the local-dev default.
SCHEMA_DIR=../shared/schemas

# ---- Trained model assets (Stage 1 CNN classifier) --------------------------
# Directory containing cnn_classifier.pt. If absent, classify() falls back to
# the rule-based heuristic — pipeline still runs, just less accurate.
MODEL_DIR=models

# ---- Redis (Celery broker + backend, Stage 3 async) -------------------------
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# ---- Google Gemini (Stage 3 LLM generation) ---------------------------------
# REQUIRED for /api/v1/generate-floor-plan. Get from
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Component 02 integration (Stage 4 fire-and-forget POST) ----------------
# Optional. When unset, Stage 4 logs and skips the integration POST — rendering
# is never blocked by C02 availability.
# Example: http://localhost:8002
C02_BASE_URL=

# ---- Supabase pgvector RAG store (Stage 3 + seeding scripts) ----------------
# Used by stages/stage3_floor_plan/rag_retriever.py and the seeding scripts
# (scripts/seed_rag.py, scripts/seed_from_images.py). When unset, RAGRetriever
# falls back to hardcoded design norms and the seed scripts exit early.
# SUPABASE_KEY should be the anon key — it is gated by Row Level Security.
SUPABASE_URL=
SUPABASE_KEY=

# ---- scripts/seed_from_images.py only ---------------------------------------
# Folder of CVC-FP floor plan PNGs (the dataset's X folder).
FPP_IMAGE_DIR=
