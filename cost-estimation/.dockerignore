# The image is the API only: main.py, layers/, models/ and data/. Dependencies
# come from uv.lock inside the image, so the local .venv must never be copied in.
.venv/
.env
.env.*

# Not needed at runtime: tests, training/scraping scripts, generated data and
# reports, docs
tests/
scripts/
data/cost-records/
reports/
README.md
CHANGELOG.md

# Caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.claude/
.DS_Store
